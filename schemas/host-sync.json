{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/host-sync.json",
  "title": "HostSync",
  "x-version": "0.2.0",
  "description": "主机配置同步：添加/更新/删除服务器的请求与响应",
  "definitions": {
    "HostConfig": {
      "type": "object",
      "required": ["host_id", "ciphertext", "nonce", "aad", "encryption_version", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "host_id": {
          "type": "string",
          "format": "uuid",
          "description": "主机唯一标识"
        },
        "ciphertext": {
          "type": "string",
          "description": "客户端加密后的完整主机配置密文。服务端只存密文，无法解密。"
        },
        "nonce": {
          "type": "string",
          "description": "加密随机 nonce（base64 编码）。"
        },
        "aad": {
          "type": "string",
          "description": "附加认证数据（AAD），用于防止密文跨主机交换攻击。"
        },
        "encryption_version": {
          "type": "integer",
          "minimum": 1,
          "description": "客户端加密格式版本。"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "主机配置最后更新时间。"
        }
      }
    },
    "SyncRequest": {
      "type": "object",
      "required": ["operation", "hosts"],
        "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["full_sync", "add", "update", "delete"]
        },
        "hosts": {
          "type": "array",
          "items": { "$ref": "#/definitions/HostConfig" }
        },
        "device_id": {
          "type": "string",
          "description": "发起同步的设备 ID"
        },
        "sync_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "客户端最后已知同步时间戳"
        }
      }
    },
    "SyncResponse": {
      "type": "object",
      "required": ["status", "server_timestamp"],
        "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "partial", "conflict", "error"]
        },
        "server_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host_id": { "type": "string" },
              "reason": { "type": "string" },
              "server_version": { "$ref": "#/definitions/HostConfig" },
              "client_version": { "$ref": "#/definitions/HostConfig" }
            }
          }
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
