{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/host-sync.json",
  "title": "HostSync",
  "version": "0.1.0",
  "description": "主机配置同步：添加/更新/删除服务器的请求与响应",
  "definitions": {
    "HostConfig": {
      "type": "object",
      "required": ["host_id", "hostname", "username", "auth_type"],
      "properties": {
        "host_id": {
          "type": "string",
          "format": "uuid",
          "description": "主机唯一标识"
        },
        "label": {
          "type": "string",
          "description": "用户自定义的显示名称，如「东京 VPS」"
        },
        "hostname": {
          "type": "string",
          "description": "服务器地址（IP 或域名）"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "username": {
          "type": "string",
          "description": "SSH 用户名"
        },
        "auth_type": {
          "type": "string",
          "enum": ["password", "private_key"],
          "description": "认证方式"
        },
        "encrypted_credential": {
          "type": "string",
          "description": "AES-256-GCM 加密后的认证凭据（密码或私钥）。服务端只存密文无法解密。"
        },
        "encrypted_credential_nonce": {
          "type": "string",
          "description": "AES-256-GCM 加密用的 nonce"
        },
        "default_session": {
          "type": "string",
          "description": "默认连接的 tmux/screen 会话名"
        },
        "multiplexer_type": {
          "type": "string",
          "enum": ["tmux", "screen", "zellij", "pty"],
          "default": "tmux"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "用户自定义标签，如 [\"production\", \"tokyo\"]"
        }
      }
    },
    "SyncRequest": {
      "type": "object",
      "required": ["operation", "hosts"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["full_sync", "add", "update", "delete"]
        },
        "hosts": {
          "type": "array",
          "items": { "$ref": "#/definitions/HostConfig" }
        },
        "device_id": {
          "type": "string",
          "description": "发起同步的设备 ID"
        },
        "sync_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "客户端最后已知同步时间戳"
        }
      }
    },
    "SyncResponse": {
      "type": "object",
      "required": ["status", "server_timestamp"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "partial", "conflict", "error"]
        },
        "server_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host_id": { "type": "string" },
              "reason": { "type": "string" },
              "server_version": { "$ref": "#/definitions/HostConfig" },
              "client_version": { "$ref": "#/definitions/HostConfig" }
            }
          }
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
