{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/events/agent-state.json",
  "title": "AgentStateEvent",
  "x-version": "0.2.0",
  "description": "守护进程上报的 Agent 状态变化事件",
  "type": "object",
  "required": ["event_id", "timestamp", "session_id", "agent_type", "state"],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "事件唯一标识"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "事件发生时间（UTC）"
    },
    "session_id": {
      "type": "string",
      "description": "会话标识，格式: {host_id}/{multiplexer_type}/{session_name}"
    },
    "agent_type": {
      "$ref": "../common.json#/definitions/agent_type"
    },
    "state": {
      "$ref": "../common.json#/definitions/agent_state"
    },
    "previous_state": {
      "$ref": "../common.json#/definitions/agent_state"
    },
    "detail": {
      "type": "object",
      "description": "状态相关的详细信息",
      "properties": {
        "message": {
          "type": "string",
          "description": "人类可读的状态描述"
        },
        "prompt": {
          "type": "string",
          "description": "Agent 的交互提示文本（如 \"Approve changes? (y/n/d/r)\"）"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "description": "审批涉及的文件数量"
        },
        "file_list": {
          "type": "array",
          "items": { "type": "string" },
          "description": "审批涉及的文件路径列表（脱敏后，仅为文件名，不含完整路径）"
        },
        "error_code": {
          "type": "string",
          "description": "错误码，仅 state=error 时有值"
        },
        "error_message": {
          "type": "string",
          "description": "错误描述，仅 state=error 时有值"
        }
      }
    },
    "source": {
      "$ref": "../common.json#/definitions/state_source"
    },
    "protocol_version": {
      "type": "string",
      "description": "协议版本号（semver），用于向后兼容检测"
    },
    "daemon_version": {
      "type": "string",
      "description": "守护进程版本号"
    }
  }
}
