{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/events/session-lifecycle.json",
  "title": "SessionLifecycleEvent",
  "x-version": "0.3.0",
  "description": "守护进程上报的会话生命周期事件（会话创建/销毁/暂停/恢复）",
  "type": "object",
  "required": ["event_id", "timestamp", "session_id", "event_type", "multiplexer_type"],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "description": "会话标识"
    },
    "event_type": {
      "type": "string",
      "enum": ["session_created", "session_attached", "session_detached", "session_destroyed"],
      "description": "生命周期事件类型"
    },
    "multiplexer_type": {
      "$ref": "../common.json#/definitions/multiplexer_type"
    },
    "session_name": {
      "type": "string",
      "description": "复用器内的会话名"
    },
    "agent_type": {
      "$ref": "../common.json#/definitions/agent_type"
    },
    "pane_count": {
      "type": "integer",
      "minimum": 0,
      "description": "窗格数量"
    },
    "protocol_version": {
      "type": "string",
      "description": "协议版本号（semver）"
    },
    "daemon_version": {
      "type": "string",
      "description": "守护进程版本号"
    }
  }
}
