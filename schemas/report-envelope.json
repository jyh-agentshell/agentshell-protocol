{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/report-envelope.json",
  "title": "ReportEnvelope",
  "x-version": "0.3.0",
  "description": "daemon 到服务端的签名状态上报信封；载荷只允许状态元数据，绝不包含终端输出、代码或 SSH 私钥。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "host_id",
    "timestamp",
    "nonce",
    "capabilities",
    "payload_type",
    "payload_base64",
    "payload_sha256",
    "signature"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "host_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{22}==$|^[A-Za-z0-9+/]{23}=$|^[A-Za-z0-9+/]{24,}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["agent_state", "session_lifecycle"]
      },
      "uniqueItems": true
    },
    "payload_type": {
      "type": "string",
      "enum": ["agent_state", "session_lifecycle"]
    },
    "payload_base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
