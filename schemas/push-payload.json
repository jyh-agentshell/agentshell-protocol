{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshell.dev/schemas/push-payload.json",
  "title": "PushPayload",
  "x-version": "0.3.1",
  "description": "P2.3 最小隐私推送载荷；不承载终端、代码、命令、路径、diff 或凭据。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "notification_id", "event_level", "host_id", "session_id", "state", "occurred_at", "expires_at", "collapse_key", "deep_link"],
  "properties": {
    "protocol_version": { "type": "string", "const": "0.3.1" },
    "notification_id": { "type": "string", "format": "uuid" },
    "event_level": { "type": "string", "enum": ["critical", "warning", "info"] },
    "host_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "state": { "type": "string", "enum": ["running", "awaiting_approval", "idle", "error", "terminated"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "collapse_key": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "deep_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "session_id"],
      "properties": {
        "host_id": { "type": "string", "format": "uuid" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
