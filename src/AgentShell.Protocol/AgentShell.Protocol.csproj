<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentShell.Protocol</RootNamespace>
    <AssemblyName>AgentShell.Protocol</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet 包元数据 -->
    <PackageId>AgentShell.Protocol</PackageId>
    <Version>0.1.0</Version>
    <Authors>AgentShell Contributors</Authors>
    <Description>AgentShell 通信协议 —— 事件模型、DTO、枚举的共享类库。</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jyh-agentshell/agentshell-protocol</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>agentshell;protocol;ai-agent;terminal;ssh</PackageTags>

    <!-- 生成 XML 文档 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
