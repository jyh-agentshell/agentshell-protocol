<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentShell.Protocol</RootNamespace>
    <AssemblyName>AgentShell.Protocol</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet 包元数据 -->
    <PackageId>AgentShell.Protocol</PackageId>
    <!-- Version 由 Directory.Build.props 统一管理，CI 由 tag 驱动覆盖 -->
    <Authors>AgentShell Contributors</Authors>
    <Description>AgentShell 通信协议 —— 事件模型、DTO、枚举的共享类库。</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jyh-agentshell/agentshell-protocol</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>agentshell;protocol;ai-agent;terminal;ssh</PackageTags>

    <!-- 生成 XML 文档（JSON Schema 为权威文档，XML 注释为辅助） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- 符号包 -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
